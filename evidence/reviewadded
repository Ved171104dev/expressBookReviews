$ TOKEN=$(curl -sS -X POST http://localhost:5000/customer/login -H "Content-Type: application/json" -d "{\"username\":\"${BOOK_USER}\",\"password\":\"${BOOK_PASSWORD}\"}" | jq -r '.accessToken')
$ curl -sS -X PUT http://localhost:5000/customer/auth/review/1 -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" -d '{"review":"A fascinating and thought-provoking novel."}' | jq
{
  "message": "Review added or updated successfully.",
  "reviews": {
    "bookstudent2026": "A fascinating and thought-provoking novel."
  }
}
